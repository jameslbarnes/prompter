# Server
NODE_ENV=development
PORT=3001
BASE_URL=http://localhost:3001
SESSION_SECRET=replace_with_a_long_random_value
ADMIN_EMAIL=admin@example.com

# AI providers
CLAUDE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
EXA_API_KEY=

# Firebase Admin
# Prefer one of these env vars in shared/deployed environments.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Google Cloud Storage
GOOGLE_CLOUD_CREDENTIALS=
GOOGLE_CLOUD_CREDENTIALS_BASE64=
GCS_BUCKET_NAME=prompter-media

# Email
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com
SENDGRID_FROM_NAME=Prompter
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3001/api/gmail/callback

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRODUCT_ID=
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRODUCT_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_TEAM_PRODUCT_ID=
STRIPE_TEAM_PRICE_ID=

# Optional memory stack
MEM0_API_KEY=
USE_CUSTOM_VECTOR_STORE=false
DISABLE_NEO4J=true
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
QDRANT_URL=
QDRANT_API_KEY=

# Optional campaign/search features
PRODUCT_HUNT_DEVELOPER_TOKEN=

# Media tuning
MEDIA_QUEUE_CONCURRENCY=2
REPORT_VIDEO_STITCH_WIDTH=1920
REPORT_VIDEO_STITCH_HEIGHT=1080
REPORT_VIDEO_NORMALIZE_TIMEOUT_MS=180000
REPORT_VIDEO_CONCAT_TIMEOUT_MS=600000
REPORT_VIDEO_FALLBACK_WORDS_PER_SECOND=2.35
REPORT_VIDEO_FALLBACK_PADDING_SECONDS=2
REPORT_VIDEO_FALLBACK_MAX_SECONDS=900

# Misc
SCHOOL_SURVEY_TO_EMAIL=recipient@example.com
SHAPE_CONFIG_ADMIN_USER_ID=
